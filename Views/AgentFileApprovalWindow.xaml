<Window x:Class="Clicky.Windows.Views.AgentFileApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review agent files" Width="620" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#101211" Foreground="#ECEEED">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#202221" />
    <SolidColorBrush x:Key="Border" Color="#373B39" />
    <SolidColorBrush x:Key="Secondary" Color="#ADB5B2" />
    <SolidColorBrush x:Key="Tertiary" Color="#77807C" />
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="170" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Review agent files" FontFamily="Segoe UI Variable" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="SummaryText" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="12" />
      <TextBlock x:Name="WorkspaceText" Foreground="{StaticResource Tertiary}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="10" />
    </StackPanel>

    <Border Grid.Row="1" Background="#2A2014" BorderBrush="#6B4B22" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,14,0,10">
      <TextBlock Text="No commands will run. Existing files marked Overwrite are backed up before changes are written." Foreground="#F4B860" TextWrapping="Wrap" FontSize="11" />
    </Border>

    <ListView x:Name="FileList" Grid.Row="2" SelectionChanged="FileSelected" Background="#171918" Foreground="{StaticResource Secondary}" BorderBrush="{StaticResource Border}" BorderThickness="1">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="Foreground" Value="{StaticResource Secondary}" />
          <Setter Property="Background" Value="Transparent" />
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="#101211" />
              <Setter Property="Background" Value="#DCE4E1" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="File" Width="350" DisplayMemberBinding="{Binding RelativePath}" />
          <GridViewColumn Header="Action" Width="90" DisplayMemberBinding="{Binding Action}" />
          <GridViewColumn Header="Chars" Width="80" DisplayMemberBinding="{Binding CharacterCount}" />
        </GridView>
      </ListView.View>
    </ListView>

    <TextBox x:Name="PreviewText" Grid.Row="3" Margin="0,10,0,10" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
             Background="#171918" Foreground="#D9DEDC" BorderBrush="{StaticResource Border}" BorderThickness="1"
             FontFamily="Cascadia Mono" FontSize="11" Padding="10" />

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <CheckBox x:Name="ReviewCheck" Content="I reviewed these paths and changes" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Checked="ReviewChanged" Unchecked="ReviewChanged" />
      <Button Grid.Column="1" Content="Cancel" Click="Cancel" Background="{StaticResource Surface}" Foreground="{StaticResource Secondary}" BorderThickness="0" Padding="15,9" Margin="0,0,8,0" Cursor="Hand" />
      <Button x:Name="ApproveButton" Grid.Column="2" Content="Write files" Click="Approve" IsEnabled="False" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="15,9" FontWeight="SemiBold" Cursor="Hand" />
    </Grid>
  </Grid>
</Window>
