<Window x:Class="Clicky.Windows.Views.OnboardingVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="370" Height="252" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="#101211" Foreground="#ECEEED">
  <Border BorderBrush="#373B39" BorderThickness="1" Background="#101211">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="12,0">
        <TextBlock Text="Meet Clicky" FontFamily="Segoe UI Variable" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="ONBOARDING" Foreground="#77807C" FontFamily="Segoe UI Variable" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>

      <Grid Grid.Row="1" Background="#171918">
        <StackPanel x:Name="FallbackPanel" Panel.ZIndex="1" Background="#171918" VerticalAlignment="Stretch" Margin="0" Visibility="Visible">
          <StackPanel VerticalAlignment="Center" Margin="24">
          <TextBlock Text="Clicky lives beside your cursor." FontFamily="Segoe UI Variable" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Hold Control+Alt, ask about anything on your screen, and release. Clicky captures only that interaction, answers aloud, and can point to what it means."
                     Foreground="#ADB5B2" FontFamily="Segoe UI Variable" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
          <TextBlock x:Name="FallbackReasonText" Text="Loading the public onboarding video…" Foreground="#77807C" FontFamily="Segoe UI Variable" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel>
        </StackPanel>
        <wv2:WebView2 x:Name="Player" Panel.ZIndex="0" />
      </Grid>
    </Grid>
  </Border>
</Window>
