<Window x:Class="Clicky.Windows.Views.EmailApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review email" Width="600" Height="590"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#101211" Foreground="#ECEEED">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#202221" />
    <SolidColorBrush x:Key="Border" Color="#373B39" />
    <SolidColorBrush x:Key="Secondary" Color="#ADB5B2" />
    <SolidColorBrush x:Key="Tertiary" Color="#77807C" />
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Review email" FontFamily="Segoe UI Variable" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Clicky will send this message only after your explicit confirmation." Foreground="{StaticResource Secondary}" Margin="0,6,0,0" FontSize="12" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="From" Foreground="{StaticResource Tertiary}" FontSize="11" VerticalAlignment="Center" />
      <TextBlock x:Name="FromText" Grid.Column="1" Foreground="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" />
    </Grid>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="To / Cc" Foreground="{StaticResource Tertiary}" FontSize="11" VerticalAlignment="Top" />
      <TextBlock x:Name="RecipientsText" Grid.Column="1" Foreground="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" />
    </Grid>
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="Subject" Foreground="{StaticResource Tertiary}" FontSize="11" VerticalAlignment="Center" />
      <TextBlock x:Name="SubjectText" Grid.Column="1" Foreground="#ECEEED" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Grid>

    <TextBox x:Name="BodyText" Grid.Row="4" Margin="0,16,0,12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" Background="#171918" Foreground="#D9DEDC" BorderBrush="{StaticResource Border}"
             BorderThickness="1" FontFamily="Segoe UI Variable" FontSize="12" Padding="12" />

    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <CheckBox x:Name="ConfirmCheck" Content="Send this email now" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Checked="ConfirmationChanged" Unchecked="ConfirmationChanged" />
      <Button Grid.Column="1" Content="Cancel" Click="Cancel" Background="{StaticResource Surface}" Foreground="{StaticResource Secondary}" BorderThickness="0" Padding="15,9" Margin="0,0,8,0" Cursor="Hand" />
      <Button x:Name="SendButton" Grid.Column="2" Content="Send email" Click="Send" IsEnabled="False" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="15,9" FontWeight="SemiBold" Cursor="Hand" />
    </Grid>
  </Grid>
</Window>
